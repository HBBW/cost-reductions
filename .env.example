# ============================================================
# CR Monitor - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!
# ============================================================

# Database Configuration
MSSQL_HOST=10.19.25.27
MSSQL_PORT=1433
MSSQL_USER=cr_app
MSSQL_PASSWORD=your_password_here
MSSQL_DATABASE=BMC
MSSQL_ENCRYPT=false

# Application Configuration
DB_CLIENT=mssql
DB_TABLE_PREFIX=CR_
JWT_SECRET=your_64_char_hex_secret_here
JWT_EXPIRES=8h

# Application Port
PORT=3000
