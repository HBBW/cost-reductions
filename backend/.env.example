# Aktifkan salah satu: mysql | mssql
DB_CLIENT=mysql

# Prefix nama tabel (mis. CR_ -> CR_ideas, CR_users, dst). Kosong = tanpa prefix.
DB_TABLE_PREFIX=

PORT=3000
JWT_SECRET=ganti-dengan-secret-acak-produksi
JWT_EXPIRES=8h

# --- MySQL (dev lokal) ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=cr_dashboard

# --- SQL Server (produksi intranet) ---
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_DATABASE=cr_dashboard
MSSQL_ENCRYPT=false
